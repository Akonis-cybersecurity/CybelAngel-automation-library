{
  "uuid": "dc41251f-0fbe-43f0-b887-1e3cf9e5ff0b",
  "name": "CybelAngel - Update Credential Status",
  "description": "Bulk update the status of CybelAngel credentials.",
  "docker_parameters": "cybelangel_update_credential_status",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "updates": {
        "description": "List of {credential_id, status} objects",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "credential_id": {"type": "string"},
            "status": {
              "type": "string",
              "enum": ["compromised", "addressed"]
            }
          },
          "required": ["credential_id", "status"]
        }
      }
    },
    "required": ["updates"]
  },
  "results": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {}
  }
}
