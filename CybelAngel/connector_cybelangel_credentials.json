{
  "uuid": "02d0686c-ddbe-408e-9708-281687ec177d",
  "name": "CybelAngel - Fetch Credentials",
  "description": "Fetch compromised credentials from CybelAngel using limit/skip pagination.",
  "docker_parameters": "cybelangel_credentials",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Fetch Credentials configuration",
    "type": "object",
    "properties": {
      "intake_key": {
        "description": "Intake key to use when sending events",
        "type": "string"
      },
      "intake_server": {
        "description": "Intake server URL",
        "default": "https://intake.sekoia.io",
        "type": "string"
      },
      "frequency": {
        "description": "Polling frequency in seconds",
        "type": "integer",
        "default": 60
      },
      "chunk_size": {
        "description": "Number of events per push batch",
        "type": "integer",
        "default": 100
      },
      "limit": {
        "description": "Number of credentials per API page",
        "type": "integer",
        "default": 10
      }
    },
    "required": [
      "intake_key"
    ]
  }
}
